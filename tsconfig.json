{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@krometra/easy-data-scroll": [
        "./src/index.ts"
      ],
      "@krometra/easy-data-scroll/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "demo",
    "e2e",
    "test",
    "*.ts"
  ]
}
