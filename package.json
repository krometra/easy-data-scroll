{
  "name": "@krometra/easy-data-scroll",
  "version": "0.1.0",
  "description": "Бесконечный и виртуальный скролл без прыжков для элементов разной высоты: ядро без зависимостей, адаптеры для Vue, React и Angular",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "build:demo": "vite build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@krometra/ui-kit": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://krometra.github.io/easy-data-scroll/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krometra/easy-data-scroll.git"
  },
  "bugs": {
    "url": "https://github.com/krometra/easy-data-scroll/issues"
  },
  "keywords": [
    "infinite-scroll",
    "virtual-scroll",
    "virtual-list",
    "virtualization",
    "chat",
    "feed",
    "dynamic-height",
    "scroll-anchoring",
    "no-jump",
    "vue",
    "vue3",
    "react",
    "angular",
    "typescript",
    "framework-agnostic"
  ]
}
